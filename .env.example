# Local settings for development. Copy to .env and fill in: cp .env.example .env
# .env is ignored by git. The app keeps what you set in it in its settings file, and the login and key in
# the system keychain; these values only fill what the settings leave empty.

# The Client ID of your Spotify developer app (32 hex digits). It signs in with PKCE: no Client Secret.
SPOTIFY_CLIENT_ID=

# The redirect URI, exactly as registered in your developer app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:45231/callback

# Soloist's API key. Don't share it, or paste it into issues or logs.
SOLOIST_API_KEY=

# The path of Soloist's executable.
SOLOIST_BIN=~/.local/bin/soloist

# The device name Spotify Connect shows.
SOLOIST_DEVICE_NAME=MyGoify

# "files" keeps the login and key in files only you can read under ~/.local/share/mygoify, not the keychain.
# For development: macOS asks whether each new build may read the keychain, and development rebuilds at every change.
MYGOIFY_SECRETS=files
