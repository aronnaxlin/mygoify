# MyGoify 开发用的本地凭据。复制成 .env 再填值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进仓库。正式版会改存系统钥匙串（见 docs/DESIGN.md §4.2、§5.1）。

# Spotify 开发者应用的 Client ID（32 位十六进制）。用 PKCE 登录，不需要 Client Secret。
SPOTIFY_CLIENT_ID=

# 登录回调地址，必须和开发者应用里登记的 Redirect URI 一字不差。
SPOTIFY_REDIRECT_URI=http://127.0.0.1:45231/callback

# Soloist 的 API key。不要分享给别人，也不要贴进 issue 或日志。
SOLOIST_API_KEY=

# Soloist 可执行文件的路径。
SOLOIST_BIN=~/.local/bin/soloist

# Spotify Connect 里显示的设备名。
SOLOIST_DEVICE_NAME=MyGoify
